    "institution": "0.65 * strongest + 0.35 * second strongest of student, hospital-bed and office-area percentiles",
    "routine_breadth": "0.55 * grocery-area percentile + 0.45 * institution",
    "activity": "restaurant-total-ratings percentile",
    "accessible_routine": "0.65 * routine breadth + 0.35 * activity; shown for continuity with v3.3 but not used in Fresh opportunity",
    "similarity": "100 - (0.55 * abs(R-Rp) + 0.25 * abs(B-Bp) + 0.20 * abs(A-Ap))",
    "opportunity": "0.55 * R + 0.25 * B + 0.20 * A",
    "decision_score": "50/50 weighted harmonic mean of similarity and opportunity",
    "sensitivity": "weighted harmonic mean with similarity weights 0.40, 0.50 and 0.60",
    "tie_break": "similarity desc, opportunity desc, locale_id asc"
  },
